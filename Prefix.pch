//
// Prefix header for all source files of the 'MachOView' target in the 'MachOView' project
//

// 仅当编译 Objective-C 源文件时（.m/.mm）才包含以下内容，纯 C/C++ 编译单元不会包含 Cocoa
#ifdef __OBJC__
    // 引入 Cocoa 框架（Foundation + AppKit），提供 NS* 类、应用生命周期与 macOS UI API，所有 ObjC 文件都会自动包含
    #import <Cocoa/Cocoa.h>
#endif

// 引入 libkern 中的原子操作 API（如 OSAtomicIncrement64/OSAtomicDecrement64），用于无锁增减 nrow_total、nrow_loaded 等（需 MV_STATISTICS）
#include <libkern/OSAtomic.h>
